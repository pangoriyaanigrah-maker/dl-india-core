# Copy to .env (gitignored) and fill in. Never commit real credentials.

# ---------------------------------------------------------------- storage
# Pick ONE of the three.

# 1. Production (Vercel / Render / Fly): paste the whole service-account
#    JSON key as a single-line value.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...",...}

# 2. Local dev: path to the key file. Defaults to ./service-account.json
#    next to main.py, so you can just drop the file there and set nothing.
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# 3. No Google at all: store everything in a plain folder. Useful for
#    development and what the test suite uses.
# DRIVE_LOCAL_DIR=./drive_local

# Optional: use an existing Drive folder instead of letting the service
# account create its own. REQUIRED if you want the folder to appear in
# your own Drive -- see docs/GOOGLE_DRIVE_SETUP.md.
# DRIVE_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# Folder name, if the backend creates it. Default: Portfolio
# DRIVE_FOLDER_NAME=Portfolio

# ------------------------------------------------------------------- api
# Comma-separated origins allowed to call the API. Default "*" -- fine for
# a single-user tool, but set it to your Vercel URL once deployed.
# CORS_ORIGINS=https://dl-india-core.vercel.app
