__pycache__/
.pytest_cache/
~$*

# Service account key and env. NEVER commit these.
service-account.json
backend/service-account.json
.env

# Your Excel files. The book lives on Google Drive; these are the inputs
# you upload, and a binary xlsx can't be diffed or reviewed anyway.
*.xlsx

# Local storage backend (DRIVE_LOCAL_DIR), and the one-off starter files
# from backend/make_starter_files.py.
drive_local/
drive_starter/

# Editor config
.claude/
